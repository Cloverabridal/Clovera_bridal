# SMTP credentials for the "Book an Appointment" form (src/lib/mailer.ts).
# Until these are set, booking requests are logged to the server console
# instead of emailed — safe for local development.
#
# Using Gmail: SMTP_PASS must be a 16-character Google "App Password"
# (myaccount.google.com/apppasswords), NOT the normal Gmail login password.
# Requires 2-Step Verification to be enabled on the Google account first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cloverabridal@gmail.com
SMTP_PASS=

# Where appointment requests are sent.
BOOKING_TO_EMAIL=cloverabridal@gmail.com
# Optional — defaults to SMTP_USER if unset.
BOOKING_FROM_EMAIL=cloverabridal@gmail.com
